# Copy to `.env.local` and fill in. Vite only exposes `VITE_`-prefixed vars.

# ── Notes service (notes_app) ────────────────────────────────────────────────
# Base URL of the standalone Notes backend. Required — /notes makes no HTTP
# calls without it and shows a configuration error instead of an empty list.
#
# In dev use `/notes-api`, which the Vite proxy forwards to NOTES_API_TARGET.
# That keeps requests same-origin: the dev server is on :3000 and the service's
# cors_origins lists only :8080 and :5173, so a direct absolute URL fails its
# preflight. In production set the service's real origin — and make sure the
# backend's cors_origins includes the deployed frontend origin.
VITE_NOTES_API_URL=/notes-api
# NOTES_API_TARGET=http://localhost:8000

# Optional: a token dedicated to the Notes service. When unset, the Pincer
# shared token stored in localStorage under `pincer.web.auth` is used, which is
# the normal case (ADR 0001 — the Notes service reuses Pincer's auth).
# VITE_NOTES_TOKEN=

# Optional: keep the Docs mock AI reachable for offline work.
# VITE_AI_MOCK=1

# ── Pincer ───────────────────────────────────────────────────────────────────
# VITE_PINCER_API_URL=http://localhost:8100
# VITE_PINCER_TOKEN=

# ── Login (see the note in docs/notes-backend.md) ────────────────────────────
# These are compared in the browser, which means anyone can read them. They are
# on their way out; do not put a real credential here.
VITE_AUTH_EMAIL=you@example.com
VITE_AUTH_PASSWORD=change-me
